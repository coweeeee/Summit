{
  "expo": {
    "name": "Summit",
    "slug": "summit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "summit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coweeeee.summit",
      "buildNumber": "2",
      "appleTeamId": "6NKUB3U255",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#0f1a0f",
      "package": "com.coweeeee.summit",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withSigningConfig",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Summit uses your photo library so you can add photos to your hikes and set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Summit uses your location to show which trails are closest to you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "shareBaseUrl": "https://summit-api-server.vercel.app",
      "appStoreId": "",
      "router": {},
      "eas": {
        "projectId": "fa069bdc-6f80-440d-b1da-391946f55a13"
      }
    },
    "owner": "cowee"
  }
}
