# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# Both values come from the Supabase dashboard for the Summit project:
#
#   EXPO_PUBLIC_SUPABASE_URL      Project Settings -> Data API -> Project URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY Project Settings -> API Keys
#
# The key is the *publishable* one, never the service role key -- anything
# prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time and is
# readable by anyone who downloads the app. This project currently ships the
# legacy JWT-style key (`eyJ...`) rather than the newer `sb_publishable_...`
# format; either works, but they are different credentials, so don't mix them.
#
# Not listed here on purpose: the share landing page URL. That lives in
# app.json under `extra.shareBaseUrl`, because it is public and belongs in
# version control rather than in per-machine config.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
